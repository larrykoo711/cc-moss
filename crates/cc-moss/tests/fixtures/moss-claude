#!/bin/bash
# Stand-in for Moss's Claude Code in e2e tests. It draws a prompt (❯) and
# reads its terminal the way Claude Code does: bracketed paste on, a pasted
# text stays in the input until Enter, Esc clears it. On Enter it writes the
# user entry and its reply to the transcript and runs the Stop hook from its
# own .claude/settings.json, as Claude Code would.
#
# What it answers: "echo: <text>". A message with "slow" in it waits for
# $CC_MOSS_FAKE_DIR/release before answering (a long turn); with "confirm"
# it also shows a confirm prompt meanwhile; with "buttons" it adds a
# [[buttons:]] marker; session news ([Update] / [动态]) gets [[silent]].
# Every message it hears is appended to $CC_MOSS_FAKE_DIR/moss-heard.txt.
[ "$1" = agents ] && { echo '[]'; exit 0; }
sid="" boot="" name="" source=startup
while [ $# -gt 0 ]; do
  case "$1" in
    --session-id) sid="$2"; shift 2 ;;
    --resume) sid="$2"; source=resume; shift 2 ;;
    -n) name="$2"; shift 2 ;;
    --name=*) name="${1#--name=}"; shift ;;
    -*) shift ;;
    *) boot="$1"; shift ;;
  esac
done
export CLAUDE_PID=$$ CLAUDE_CODE_SESSION_ATTENDED=1 CLAUDE_CODE_ENTRYPOINT=cli
transcript="$CC_MOSS_FAKE_DIR/$sid.jsonl"

esc() {
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\t'/\\t}; s=${s//$'\r'/}
  printf '%s' "$s"
}
now() { perl -MTime::HiRes -MPOSIX -e '$t=Time::HiRes::time; printf "%s.%03dZ", strftime("%Y-%m-%dT%H:%M:%S", gmtime($t)), ($t-int($t))*1000'; }
user() {
  printf '{"type":"user","timestamp":"%s","isSidechain":false,"message":{"role":"user","content":"%s"}}\n' "$(now)" "$(esc "$1")" >> "$transcript"
}
assistant() {
  printf '{"type":"assistant","timestamp":"%s","isSidechain":false,"message":{"role":"assistant","stop_reason":"end_turn","content":[{"type":"text","text":"%s"}]}}\n' "$(now)" "$(esc "$1")" >> "$transcript"
}
stop_hook() {
  local cmd
  cmd=$(sed -n 's/.*"command": "\(.*hook moss-stop.*\)".*/\1/p' .claude/settings.json 2>/dev/null)
  [ -n "$cmd" ] && sh -c "$cmd" < /dev/null
}
# The input box: a rule, the prompt, a rule; the cursor goes back after ❯.
prompt() { printf '\n────────\n❯ \n────────\e[1A\r\e[2C'; }

turn() {
  local text=$1 answer
  printf '%s\n' "$text" >> "$CC_MOSS_FAKE_DIR/moss-heard.txt"
  user "$text"
  case "$text" in
    "[Update]"*|"[动态]"*) answer="[[silent]]" ;;
    *buttons*) answer="echo: $text
[[buttons: Yes | No]]" ;;
    *) answer="echo: $text" ;;
  esac
  case "$text" in
    *confirm*) printf '\nDo you want to proceed?\n❯ 1. Yes\n  2. No\n' ;;
    *slow*) printf '\n✻ Thinking… (esc to interrupt)\n' ;;
  esac
  case "$text" in
    *slow*|*confirm*)
      until [ -e "$CC_MOSS_FAKE_DIR/release" ]; do sleep 0.1; done
      rm -f "$CC_MOSS_FAKE_DIR/release" ;;
  esac
  assistant "$answer"
  printf '\n⏺ %s\n' "$answer"
  stop_hook
}

session_start() {
  printf '%s' "{\"session_id\":\"$sid\",\"cwd\":\"$PWD\",\"source\":\"$1\",\"session_title\":\"$name\",\"transcript_path\":\"$transcript\"}" \
    | "$CC_MOSS_BIN" hook session-start > /dev/null
}

# Until a lone Esc comes in (a panel waits for it).
wait_for_esc() {
  local c n
  while true; do
    IFS= read -r -n1 -d '' c || { sleep 0.1; continue; }
    [ "$c" = $'\e' ] || continue
    IFS= read -r -n1 -t 1 -d '' n || return 0
  done
}

# A Claude Code command: panels show until Esc; /clear starts a new
# transcript; /compact takes a moment.
slash() {
  case "$1" in
    /usage)
      # Taller than the window: its top scrolls off, as on a real 100x50.
      printf '\n> /usage\n\n  Current session   12%% used\n  Current week      40%% used\n'
      i=0; while [ $i -lt 60 ]; do printf '  Skills %% of usage, line %s\n' "$i"; i=$((i+1)); done
      printf '  0%% used\n\n  d to day · w to week\n  Usage credits: 40 left\n\n  Esc to cancel\n'
      wait_for_esc ;;
    /status|/context|/help)
      printf '\n> %s\n\n  Settings  Status   Config   Usage   Stats\n\n  Version: 2.1.303\n  Model: fake\n\n  Esc to cancel\n' "$1"
      wait_for_esc ;;
    # A line and straight back to the prompt (an API account's /cost).
    /cost)
      printf '\n> /cost\n  Total cost: $0.12\n' ;;
    # Nothing new at all.
    /stats)
      printf '\n> /stats\n' ;;
    # Like Claude Code: the new name goes into the transcript.
    /rename\ *)
      name="${1#/rename }"
      printf '{"type":"custom-title","customTitle":"%s","sessionId":"%s"}\n' "$(esc "$name")" "$sid" >> "$transcript" ;;
    /clear)
      sid=$( (uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid) | tr "A-Z" "a-z")
      transcript="$CC_MOSS_FAKE_DIR/$sid.jsonl"
      printf '\e[2J\e[H'
      session_start clear ;;
    /compact*)
      printf '\n✻ Compacting… (esc to interrupt)\n'
      sleep 1 ;;
  esac
  printf '%s\n' "$1" >> "$CC_MOSS_FAKE_DIR/moss-commands.txt"
}

# With CC_MOSS_FAKE_TRUST set, a fresh machine's first question: trust this
# folder? It waits for Enter (yes), and asks only once.
if [ -n "$CC_MOSS_FAKE_TRUST" ] && [ ! -e "$CC_MOSS_FAKE_DIR/trusted" ]; then
  printf '\n Do you trust the files in this folder?\n\n %s\n\n ❯ 1. Yes, proceed\n   2. No, exit\n\n Enter to confirm · Esc to exit\n' "$PWD"
  IFS= read -r _
  touch "$CC_MOSS_FAKE_DIR/trusted"
  printf '\e[2J\e[H'
fi

session_start "$source"
[ -n "$boot" ] && turn "$boot"

# Raw input, no echo: it draws what it takes in itself. (macOS ships bash
# 3.2: no fractional read timeouts.)
stty -echo -icanon min 1 2>/dev/null
printf '\e[?2004h'
prompt
buf="" paste=0
while true; do
  IFS= read -r -n1 -d '' c || { sleep 0.1; continue; }
  if [ "$c" = $'\e' ]; then
    if IFS= read -r -n1 -t 1 -d '' n && [ "$n" = "[" ]; then
      seq=""
      while IFS= read -r -n1 -d '' n; do
        seq+=$n
        case "$n" in [A-Za-z~]) break ;; esac
      done
      case "$seq" in
        200~) paste=1 ;;
        201~) paste=0 ;;
      esac
    else
      # Esc: the input is cleared.
      buf=""
      prompt
    fi
    continue
  fi
  if [ "$c" = $'\r' ] || [ "$c" = $'\n' ]; then
    if [ "$paste" = 1 ]; then
      buf+=$'\n'
      printf '\n  '
      continue
    fi
    [ -z "$buf" ] && continue
    text=$buf
    buf=""
    case "$text" in
      /*) slash "$text" ;;
      *) turn "$text" ;;
    esac
    prompt
    continue
  fi
  buf+=$c
  printf '%s' "$c"
done

class CcMoss < Formula
  desc "Recoverable Claude Code sessions in tmux"
  homepage "https://github.com/larrykoo711/cc-moss"
  license "MIT"

  depends_on "tmux"

  on_macos do
    on_arm do
      url "https://github.com/larrykoo711/cc-moss/releases/download/v@VERSION@/cc-moss-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_DARWIN_ARM@"
    end
    on_intel do
      url "https://github.com/larrykoo711/cc-moss/releases/download/v@VERSION@/cc-moss-v@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_DARWIN_X64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/larrykoo711/cc-moss/releases/download/v@VERSION@/cc-moss-v@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_LINUX_ARM@"
    end
    on_intel do
      url "https://github.com/larrykoo711/cc-moss/releases/download/v@VERSION@/cc-moss-v@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_LINUX_X64@"
    end
  end

  def install
    bin.install "cc-moss"
  end

  def caveats
    <<~EOS
      Set up the hooks, tmux and prompt (it shows every change and asks first):
        cc-moss install
        cc-moss doctor

      cc-moss runs Claude Code but does not install it.
      Before `brew uninstall cc-moss`, run `cc-moss install --uninstall`:
      it removes the hooks and every block it added, so Claude Code
      is not left calling a binary that is gone.
    EOS
  end

  test do
    assert_match "cc-moss #{version}", shell_output("#{bin}/cc-moss --version")
  end
end

    },
    {
      "dot": "emerald",
      "title": "Refresh",
      "items": [
        "Hook writes wake the watcher",
        "events --since: what just happened",
        "ls --json: how things are now"
      ]
    },
    {
      "dot": "amber",
      "title": "Ships together",
      "items": [
        "Same version and release as the CLI",
        "Homebrew formula carries the app",
        "cc-moss update upgrades both"
      ]
    }

  "stages": [{"label":"用户"},{"label":"本次来源"},{"label":"明确确认"},{"label":"安全检查"},{"label":"启动后"}],
  "nodes": [
    {"id":"user","type":"frontend","label":"单行未知来源","sublabel":"没有预选或自动启动","stage":0,"row":1},
    {"id":"default","type":"frontend","label":"默认配置","sublabel":"不指定配置目录","stage":1,"row":0},
    {"id":"directory","type":"frontend","label":"选择配置目录","sublabel":"原生目录选择器","stage":1,"row":2},
    {"id":"confirm","type":"frontend","label":"确认并找回","sublabel":"展示来源与选中路径","stage":2,"row":1},
    {"id":"guard","type":"backend","label":"当前记录预检","sublabel":"单目标与来源约束","stage":3,"row":1},
    {"id":"launch","type":"backend","label":"本次启动参数","sublabel":"默认清变量或指定目录","stage":4,"row":1},
    {"id":"hook","type":"backend","label":"SessionStart","sublabel":"记录实际新启动来源","stage":4,"row":3}
  ],
  "flows": [
    {"from":"user","to":"default","label":"主动选择"},
    {"from":"user","to":"directory","label":"主动选择"},
    {"from":"default","to":"confirm","label":"默认来源"},
    {"from":"directory","to":"confirm","label":"绝对目录"},
    {"from":"confirm","to":"guard","label":"一次性参数"},
    {"from":"guard","to":"launch","label":"检查通过"},
    {"from":"launch","to":"hook","label":"正常启动事件"}
  ],
  "cards": [
    {"dot":"cyan","title":"T2.17 设计合同","items":["这是行为设计，不是已提交源码证明。unknown 才提供选择；unsupported 或 invalid 不提供绕过入口。","App 用 slot、session 与单次 token 绑定选择和确认；旧失败仅用于呈现，当前记录由后端再次预检。"]},
    {"dot":"slate","title":"取消与迟到回调","items":["每次目录选择使用新 token，同一时间最多一个目录选择器。取消或身份变化后，迟到回调不能恢复旧选择。","默认与目录都先展示再确认；取消零 CLI 调用。批量失败按行处理，不能共用一次来源选择。"]},
    {"dot":"amber","title":"副作用边界","items":["来源参数只用于本次单目标找回，不预写旧快照，也不修改全局设置。参数独立传值，不拼接 shell。","来源与身份预检失败不启动；真正的终端启动失败仍保留其准确错误。SessionStart 正常记录实际新来源。"]}
  ]

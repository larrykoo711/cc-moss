    {"id":"ready","type":"frontend","label":"有效原来源","sublabel":"灰路径与直接找回","stage":2,"row":0},
    {"id":"unknown","type":"frontend","label":"原设置未记录","sublabel":"明确当前默认提案","stage":2,"row":1},
    {"id":"repair","type":"frontend","label":"路径确有异常","sublabel":"更换位置后确认","stage":2,"row":2},
    {"id":"blocked","type":"frontend","label":"检查不可用","sublabel":"不换源、不自动重试","stage":2,"row":3},
    {"id":"recorded","type":"backend","label":"Recorded 恢复","sublabel":"不附来源覆盖参数","stage":3,"row":0},
